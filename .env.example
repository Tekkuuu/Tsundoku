# Copy to `.env` and fill in the blanks: `cp .env.example .env`.
# Only DATABASE_URL and BETTER_AUTH_SECRET are strictly required;
# everything else has a sane default.

# --- App ---
# Public base URL of this instance. Used by SvelteKit (CSRF/origin check)
# and Better Auth (links/cookies). No trailing slash.
# Example: "https://tsundoku.example.com". Empty = development default.
ORIGIN="http://localhost:5173"

# --- Database (required) ---
# Postgres connection string used by Drizzle and the app.
DATABASE_URL="postgres://tsundoku:tsundoku@localhost:5432/tsundoku"

# --- Auth (required) ---
# Secret for signing Better Auth sessions. Use 32+ high-entropy characters
# in production. Generate with e.g. `openssl rand -base64 32`.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="some-long-string-of-characters"

# --- Registration gate (homelab, no email verification) ---
# Caps the total number of accounts. "1" = single-user, "0" = registration
# disabled, empty = unlimited. Enforced for every signup path, including
# direct calls to /api/auth.
MAX_USERS="1"

# --- Logging (optional) ---
# Pino log level. One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL="info"

# --- File storage (optional) ---
# Directory for self-hosted uploads (covers, receipts). Stored under opaque
# UUID names and served only to their owner. Defaults to "./data"; the Docker
# image uses "/data" (backed by a volume in compose.prod.yaml).
DATA_DIR="./data"
