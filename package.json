{
	"name": "tsundoku",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:backup": "node --env-file=.env scripts/backup-db.mjs",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"user:reset-password": "node --env-file=.env scripts/reset-password.mjs",
		"files:prune": "node --env-file=.env scripts/prune-files.mjs"
	},
	"dependencies": {
		"@lucide/svelte": "^1.34.0",
		"bits-ui": "^2.20.2",
		"date-fns": "^4.4.0",
		"fuse.js": "^7.5.0",
		"layerchart": "^2.4.0",
		"pdfjs-dist": "^6.4.299",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.22",
		"@inlang/paraglide-js": "^2.24.1",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/lodash": "^4.17.25",
		"@types/node": "^22.20.1",
		"better-auth": "~1.4.22",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"lodash": "^4.18.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"zod": "^4.4.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
